/**
 * Read by @sveltejs/adapter-cloudflare ALONE (svelte.config.js). The adapter
 * writes its worker to this file's `main`; the real wrangler.jsonc names
 * worker/index.ts, which imports that output and adds the Durable Object.
 * Keep `assets.directory` the same in both.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "apollo-app-sveltekit",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-10-24",
	"compatibility_flags": ["nodejs_als"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" }
}
