# GitHub OAuth Configuration
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set Authorization callback URL to: http://localhost:8787/auth/callback/github (for dev)
# For production: https://your-domain.com/auth/callback/github

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Auth.js Secret
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_string_here

# App URL (for OAuth redirects)
AUTH_TRUST_HOST=true
ORIGIN=http://localhost:8787

# OpenAI API Key (for Voice Chat feature)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
