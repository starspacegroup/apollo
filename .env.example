# GitHub OAuth Configuration
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set Authorization callback URL to: http://localhost:8787/auth/callback/github (for dev)
# For production: https://your-domain.com/auth/callback/github

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Auth.js Secret
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_string_here

# App URL (for OAuth redirects)
AUTH_TRUST_HOST=true
ORIGIN=http://localhost:8787

# OpenAI API Key (for Voice Chat feature)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# The wire from the local daemon (apollod) to this Worker.
# The daemon presents this token to push a board snapshot and read pending
# intents. It is not a GitHub token and not a Cloudflare token — it authorises
# reporting and nothing else. The same value must be set on the daemon side.
# A Worker with no token configured refuses every daemon request.
# Generate with: openssl rand -base64 32
APOLLO_LINK_TOKEN=your_link_token_here

# NVIDIA free tier (build.nvidia.com) — OpenAI-compatible chat/embeddings, not Realtime
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813
